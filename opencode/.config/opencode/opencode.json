{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**", ".venv/**"]
  },
  "plugin": ["@tarquinen/opencode-dcp@latest"],
  "provider": {
    "Local - 11434": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local - 11434",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "16k": {
          "name": "16k",
          "limit": {
            "context": 16384,
            "output": 8000
          }
        },
        "32k": {
          "name": "32k",
          "limit": {
            "context": 32768,
            "output": 8000
          }
        },
        "64k": {
          "name": "64k",
          "limit": {
            "context": 65536,
            "output": 8000
          }
        },
        "128k": {
          "name": "128k",
          "limit": {
            "context": 131072,
            "output": 8000
          }
        },
        "256k": {
          "name": "256k",
          "limit": {
            "context": 262144,
            "output": 8000
          }
        }
      }
    },
    "Docker - 11434": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Docker - 11434",
      "options": {
        "baseURL": "http://llamacpp:11434/v1"
      },
      "models": {
        "16k": {
          "name": "16k",
          "limit": {
            "context": 16384,
            "output": 8000
          }
        },
        "32k": {
          "name": "32k",
          "limit": {
            "context": 32768,
            "output": 8000
          }
        },
        "64k": {
          "name": "64k",
          "limit": {
            "context": 65536,
            "output": 8000
          }
        },
        "128k": {
          "name": "128k",
          "limit": {
            "context": 131072,
            "output": 8000
          }
        },
        "256k": {
          "name": "256k",
          "limit": {
            "context": 262144,
            "output": 8000
          }
        }
      }
    },

    "Beast - 11434": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Beast - 11434",
      "options": {
        "baseURL": "http://192.168.8.10:11434/v1"
      },
      "models": {
        "16k": {
          "name": "16k",
          "limit": {
            "context": 16384,
            "output": 8000
          }
        },
        "32k": {
          "name": "32k",
          "limit": {
            "context": 32768,
            "output": 8000
          }
        },
        "64k": {
          "name": "64k",
          "limit": {
            "context": 65536,
            "output": 8000
          }
        },
        "128k": {
          "name": "128k",
          "limit": {
            "context": 131072,
            "output": 8000
          }
        },
        "256k": {
          "name": "256k",
          "limit": {
            "context": 262144,
            "output": 8000
          }
        }
      }
    },
    "Beast - 11435": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Beast - 11435",
      "options": {
        "baseURL": "http://192.168.8.10:11435/v1"
      },
      "models": {
        "16k": {
          "name": "16k",
          "limit": {
            "context": 16384,
            "output": 8000
          }
        },
        "32k": {
          "name": "32k",
          "limit": {
            "context": 32768,
            "output": 8000
          }
        },
        "64k": {
          "name": "64k",
          "limit": {
            "context": 65536,
            "output": 8000
          }
        },
        "128k": {
          "name": "128k",
          "limit": {
            "context": 131072,
            "output": 8000
          }
        },
        "256k": {
          "name": "256k",
          "limit": {
            "context": 262144,
            "output": 8000
          }
        }
      }
    }
  },
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "patch": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow"
  },
  "mcp": {
    "rfc-server": {
      "type": "local",
      "command": ["npx", "-y", "@mjpitz/mcp-rfc"],
      "enabled": true
    },
    "searxng": {
      "type": "local",
      "command": ["npx", "-y", "mcp-searxng"],
      "enabled": true,
      "environment": {
        "SEARXNG_URL": "http://192.168.8.12:8090"
      }
    }

  },
  "plugin": [
    "@tarquinen/opencode-dcp@latest",
    "@franlol/opencode-md-table-formatter@latest"
  ]
}
